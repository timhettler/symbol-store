{
  "name": "next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "run-p generate:symbolstore build:app",
    "build:app": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate:symbolstore": "run-s generate:symbolstore:simple generate:symbolstore:proxy generate:symbolstore:inline",
    "generate:symbolstore:simple": "symbol-store -i ./icons -o ./public -t ./src/simple",
    "generate:symbolstore:proxy": "symbol-store -i ./icons -o ./public -t ./src/proxy -p /api/symbol-store",
    "generate:symbolstore:inline": "symbol-store -i ./icons -o ./public -t ./src/inline --inline",
    "test": "yarn generate:symbolstore"
  },
  "dependencies": {
    "@radix-ui/themes": "^3.1.6",
    "next": "15.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@timhettler/symbol-store": "*",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "npm-run-all": "^4.1.5",
    "typescript": "^5"
  }
}
